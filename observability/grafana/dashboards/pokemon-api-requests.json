        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "stats",
          "expr": "service:\"pokemon-backend\" event:\"request.completed\" NOT route:\"/api/v1/health\" | stats count() requests"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per endpoint over time",
