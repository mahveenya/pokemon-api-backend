          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "victoriametrics-logs-datasource", "uid": "victorialogs" },
          "queryType": "statsRange",
          "expr": "service:\"pokemon-backend\" event:\"request.completed\" NOT route:\"/api/v1/health\" | stats by (route) count() requests",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
